<h1><%= t'New fixed_expense'%></h1>

<%= form_for(@fixed_expense) do |f| %>
  <%= render "shared/errors", object: f.object %>

  <p>
    <%= f.label :name %><br />
    <%= f.text_field :name %>
  </p>
  <p>
    <%= f.label :valid_from %>
    <br />
    <%= f.date_select :valid_from %>
  </p>
  <p>
    <%= f.label :valid_to %>
    <br />
    <span id="disabled" style="display:none">
      <%= f.date_select :valid_to, :disabled => (true if @fixed_expense.valid_to.nil?) %>
    </span>
    <%= link_to t('I want to finish this'), '#', onclick: '$("select:disabled").removeAttr("disabled");$("#disabled").fadeIn();$(this).hide(); return false;' %>
  </p>
  <p>
    <%= f.label :amount %><br />
    <%= f.text_field :amount %>
  </p>
  <p>
    <%= f.submit t('Create') %>
  </p>
<% end %>

<%= link_to t('Back'), fixed_expenses_path %>