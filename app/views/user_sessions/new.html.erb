<h1><%= t 'Log in' %></h1>

<% if flash[:alert] %>
  <p style="color: red"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: user_session_path do |f| %>
  <%= f.label :email %><br />
  <%= f.email_field :email %><br />
  <br />
  <%= f.label :password %><br />
  <%= f.password_field :password %><br />
  <br />
  <%= f.submit t("Login") %>
<% end %>
